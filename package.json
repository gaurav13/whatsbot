{
  "name": "whatsapp-bot",
  "version": "1.0.0",
  "description": "Local WhatsApp AI automation bot using Baileys + Gemini",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "evolution:up": "docker compose -f docker-compose.evolution.yml --env-file .env.evolution up -d",
    "evolution:down": "docker compose -f docker-compose.evolution.yml --env-file .env.evolution down",
    "evolution:logs": "docker compose -f docker-compose.evolution.yml logs -f evolution-api"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@google/genai": "^1.52.0",
    "@whiskeysockets/baileys": "^6.7.18",
    "axios": "^1.21.1",
    "cheerio": "^1.2.0",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "openai": "^7.55.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  }
}
