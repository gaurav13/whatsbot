# Copy to .env.evolution (gitignored) then:
#   docker compose -f docker-compose.evolution.yml --env-file .env.evolution up -d
#
# Express stays on PORT=3000. Evolution talks to it via host.docker.internal
# (Linux/WSL: compose adds extra_hosts host-gateway).

# --- Evolution API (http://localhost:8080) ---
SERVER_URL=http://localhost:8080
AUTHENTICATION_API_KEY=GSAiEvoLocal_7f3c91e24a8b4d0e9c6f1a2b3d4e5f60
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# --- Evolution's own Postgres + Redis (not the SaaS DATABASE_URL) ---
POSTGRES_USER=evolution
POSTGRES_PASSWORD=evo_local_pg_change_me
POSTGRES_DB=evolution
POSTGRES_PORT=5433
REDIS_PORT=6380

DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:evo_local_pg_change_me@evolution-postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution_v2
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/1
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=true
CACHE_LOCAL_ENABLED=false

# Webhooks → local Express (see routes/evolutionWebhook.js)
WEBHOOK_GLOBAL_ENABLED=true
WEBHOOK_GLOBAL_URL=http://host.docker.internal:3000/webhooks/evolution
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false
WEBHOOK_EVENTS_QRCODE_UPDATED=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_MESSAGES_UPDATE=true
WEBHOOK_EVENTS_SEND_MESSAGE=true
WEBHOOK_EVENTS_LOGOUT_INSTANCE=true

QRCODE_LIMIT=30
LOG_LEVEL=ERROR
LOG_BAILEYS=error
DEL_INSTANCE=false
LANGUAGE=en

# --- App-side flag (also add these to the Express .env) ---
# WHATSAPP_PROVIDER=evolution
# EVOLUTION_API_URL=http://127.0.0.1:8080
# EVOLUTION_API_KEY=GSAiEvoLocal_7f3c91e24a8b4d0e9c6f1a2b3d4e5f60
# EVOLUTION_WEBHOOK_URL=http://host.docker.internal:3000/webhooks/evolution
# Optional: Evolution must send this as header `apikey` if set
# EVOLUTION_WEBHOOK_KEY=
